# Public (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=

# Server only — set these in Vercel, never commit real values
SUPABASE_SERVICE_ROLE_KEY=   # Supabase > Project Settings > API > service_role. Needed for leads + /admin once RLS is on.
JWT_SECRET=                  # Any long random string. Signs /admin sessions.
ANTHROPIC_API_KEY=           # AI chat
ANTHROPIC_MODEL=             # Optional. Defaults to claude-haiku-5-5.
RESEND_API_KEY=              # Optional. Enables the new-lead email alert.
LEAD_NOTIFY_EMAIL=           # Where new-lead alerts go (comma-separated for several).
LEAD_NOTIFY_FROM=            # Optional. e.g. "PreConstructionMiami <leads@preconstructionmiami.net>" once the domain is verified in Resend.
